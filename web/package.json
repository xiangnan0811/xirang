{
  "name": "xirang-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.e2e.json",
    "check:dependency-patches": "node scripts/check-lint-dependency-patches.mjs",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "check": "npm run check:dependency-patches && npm run check:i18n && npm run typecheck && npm run lint && npm run test && npm run build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "NODE_ENV=test vitest run --coverage",
    "e2e": "playwright test",
    "e2e:evidence": "node scripts/run-e2e-evidence.mjs",
    "walkthrough": "node scripts/run-walkthrough.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.43.0",
    "i18next": "^26.7.2",
    "lucide-react": "^0.577.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.6.6",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/config-array": "file:dependency-patches/eslint-config-array-0.21.2-xirang-minimatch11-r1.tgz",
    "@eslint/eslintrc": "file:dependency-patches/eslint-eslintrc-3.3.7-xirang-minimatch11-r1.tgz",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^25.9.8",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/typescript-estree": "file:dependency-patches/typescript-eslint-typescript-estree-8.70.1-xirang-minimatch11-r1.tgz",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.13.0",
    "eslint": "file:dependency-patches/eslint-9.39.4-xirang-minimatch11-r1.tgz",
    "eslint-plugin-jsx-a11y": "file:dependency-patches/eslint-plugin-jsx-a11y-6.10.2-xirang-minimatch11-r1.tgz",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^26.1.0",
    "msw": "^2.15.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.2",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.1",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0"
  },
  "overrides": {
    "@eslint/config-array": "$@eslint/config-array",
    "@eslint/eslintrc": "$@eslint/eslintrc",
    "@typescript-eslint/typescript-estree": "$@typescript-eslint/typescript-estree",
    "nanoid": "3.3.18",
    "browserslist": "4.28.7",
    "jsdom": {
      "nwsapi": "2.2.25"
    }
  }
}
