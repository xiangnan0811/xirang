#!/usr/bin/env bash
# 暂存快检与共享文档同步规则；禁止绕过 hooks。
set -euo pipefail
STAGED=$(git diff --cached --name-only)
[[ -n "$STAGED" ]] || exit 0
REPO_ROOT="$(git rev-parse --show-toplevel)"
FAST_CHECK="$REPO_ROOT/scripts/check-pre-commit-fast.sh"
[[ -x "$FAST_CHECK" ]] || { echo "[FAIL] 缺少可执行的 pre-commit 快检脚本" >&2; exit 2; }
bash "$FAST_CHECK"
bash "$REPO_ROOT/scripts/check-doc-freshness.sh" --staged

if grep -qE '^backend/internal/database/migrations/.*\.sql$' <<<"$STAGED"; then
  bash "$REPO_ROOT/scripts/check-migration-version.sh"
  bash "$REPO_ROOT/scripts/check-migration-utc-safety.sh"
fi
