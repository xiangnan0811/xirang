#!/usr/bin/env bash
# pre-commit hook — 文档新鲜度检查
# 当代码关键文件被修改但对应文档未同步更新时阻止提交。
# 跳过：git commit --no-verify

set -euo pipefail

STAGED=$(git diff --cached --name-only 2>/dev/null || true)

if [ -z "$STAGED" ]; then
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
FAST_CHECK="${REPO_ROOT}/scripts/check-pre-commit-fast.sh"

if [ ! -x "$FAST_CHECK" ]; then
  echo "[FAIL] pre-commit 快检脚本不存在或不可执行: $FAST_CHECK" >&2
  exit 2
fi

bash "$FAST_CHECK"

WARN=0
MSGS=()

# Returns 0 if the path is ignored (thus can never be staged — check would be unsatisfiable).
is_gitignored() {
  git check-ignore -q "$1" 2>/dev/null
}

check() {
  local trigger="$1"
  local doc_re="$2"
  local msg="$3"
  if echo "$STAGED" | grep -q "$trigger"; then
    if ! echo "$STAGED" | grep -qE "$doc_re"; then
      MSGS+=("$msg")
      WARN=$((WARN + 1))
    fi
  fi
}

check "backend/internal/model/models.go" "^(backend/README_backend\.md|docs/env-vars\.md|\.trellis/spec/backend/database-guidelines\.md)$" \
  "models.go 已修改，请同步更新 backend 模型/数据库文档"

check "backend/internal/api/router.go" "^backend/README_backend\.md$" \
  "router.go 已修改，请同步更新 backend/README_backend.md 接口列表"

check "web/src/router.tsx" "^(README\.md|docs/|\.trellis/spec/frontend/directory-structure\.md)$" \
  "router.tsx 已修改，请同步更新公开入口文档或 frontend structure spec"

check "backend/internal/database/migrations/" "^(backend/README_backend\.md|docs/deployment\.md|docs/env-vars\.md|\.trellis/spec/backend/database-guidelines\.md)$" \
  "数据库迁移文件有变更，请同步更新 backend 迁移/部署文档或数据库规范"

check "backend/internal/config/config.go" "^docs/env-vars\.md$" \
  "config.go 已修改，请同步更新 docs/env-vars.md"

# 规则 6：发布/镜像/部署/版本检查变更 → 发布相关文档
# 与 scripts/check-doc-freshness.sh 规则对齐：保持两边检查规则一致，避免漂移。
release_trigger_re='^(\.github/workflows/(release-please|publish-images|deploy)\.yml|docker-compose\.yml|docker-compose\.prod\.yml|\.env\.deploy|deploy/allinone/.*|deploy/nginx/.*|backend/\.env\.production\.example|backend/internal/api/handlers/version_handler\.go|CHANGELOG\.md)$'
release_doc_re='^(README\.md|CONTRIBUTING\.md|docs/deployment\.md|docs/env-vars\.md|docs/maintainers/release\.md|AGENTS\.md|\.github/PULL_REQUEST_TEMPLATE\.md)$'

if echo "$STAGED" | grep -qE "$release_trigger_re"; then
  if ! echo "$STAGED" | grep -qE "$release_doc_re"; then
    MSGS+=("发布/镜像/部署/版本检查相关文件已修改，请同步更新配套文档（README/CONTRIBUTING/docs/deployment.md/docs/env-vars.md/docs/maintainers/release.md/AGENTS.md/PULL_REQUEST_TEMPLATE）")
    WARN=$((WARN + 1))
  fi
fi

if [ "$WARN" -gt 0 ]; then
  echo ""
  echo "[WARN] 文档同步检查未通过（${WARN} 项）："
  echo ""
  for msg in "${MSGS[@]}"; do
    echo "  - $msg"
  done
  echo ""
  echo "请更新对应文档后重新提交，或使用 git commit --no-verify 跳过检查。"
  exit 1
fi

# 当 staged 改动涉及 migration 文件时，跑 UTC 安全 lint。
# 避免在每次 commit 都跑（即使未触及 migrations），保持 hook 的快速反馈。
if echo "$STAGED" | grep -qE "backend/internal/database/migrations/.*\.sql$"; then
  REPO_ROOT="$(git rev-parse --show-toplevel)"
  if [ -x "${REPO_ROOT}/scripts/check-migration-utc-safety.sh" ]; then
    if ! bash "${REPO_ROOT}/scripts/check-migration-utc-safety.sh"; then
      echo ""
      echo "[FAIL] migration UTC 安全检查未通过。修复违规或更新 EXCLUDE_GLOBS。"
      echo "       使用 git commit --no-verify 跳过（不推荐）。"
      exit 1
    fi
  fi
fi

exit 0
