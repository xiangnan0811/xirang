{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 \"$(dirname \"$(git rev-parse --path-format=absolute --git-common-dir)\")/.codex/hooks/inject-workflow-state.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^(?:trellis-implement|trellis-check|trellis-research)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 \"$(dirname \"$(git rev-parse --path-format=absolute --git-common-dir)\")/.codex/hooks/inject-subagent-context.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
