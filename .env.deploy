# ===== Xirang 部署配置 =====
# 复制此文件为 .env 并修改以下必改项
# 官方稳定版镜像通过 GitHub Release 发布到 Docker Hub。
# 快速试用可直接使用 latest；生产环境建议显式固定 IMAGE_TAG=vX.Y.Z。
# IMAGE_TAG=vX.Y.Z
# 可选：开启版本检查，推荐指向 GitHub latest release API。
# VERSION_CHECK_URL=https://api.github.com/repos/xiangnan0811/xirang/releases/latest

APP_ENV=production

# 时区（IANA 名称）。All-in-One 镜像默认 Asia/Shanghai；显式写入便于审计。
TZ=Asia/Shanghai

# ── 数据库 ──
# 默认使用 SQLite（推荐小规模部署）
DB_TYPE=sqlite
SQLITE_PATH=/data/xirang.db
# PostgreSQL 模式（取消注释并填写连接信息）：
# DB_TYPE=postgres
# DB_DSN=host=db user=xirang password=<set-db-password> dbname=xirang port=5432 sslmode=disable

# ── 必改项（安全相关）──

# 初始管理员密码（首次启动时创建 admin 账号）
ADMIN_INITIAL_PASSWORD=

# JWT 签名密钥（务必修改为强随机字符串，>= 16 字符）
JWT_SECRET=

# 敏感字段加密密钥（用于加密 SSH 密码/私钥，务必修改）
DATA_ENCRYPTION_KEY=

# ── 鉴权 ──
JWT_TTL=24h
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=1m
LOGIN_FAIL_LOCK_THRESHOLD=5
LOGIN_FAIL_LOCK_DURATION=15m
LOGIN_CAPTCHA_ENABLED=false
LOGIN_SECOND_CAPTCHA_ENABLED=false

# ── CORS ──
# 留空则自动允许同主机 Origin（适合通过 IP 或反向代理访问的场景）
# 多域名用逗号分隔，如 https://xirang.example.com
# 注意：生产环境禁止使用 *（通配符）
CORS_ALLOWED_ORIGINS=

# ── 日志 ──
LOG_LEVEL=info

# ── SSH / 通知安全 ──
# 生产环境建议保持以下默认值：阻断私网 webhook，严格校验 known_hosts。
INTEGRATION_BLOCK_PRIVATE_ENDPOINTS=true
SSH_STRICT_HOST_KEY_CHECKING=true
SSH_AUTO_ACCEPT_NEW_HOSTS=true
SSH_KNOWN_HOSTS_PATH=/data/.ssh/known_hosts

# ── /metrics 端点 ──
# /metrics 公开会泄露路由清单和流量画像；生产环境建议配置随机 token。
# METRICS_TOKEN=<set-strong-random-metrics-token>
METRICS_RATE_LIMIT=5
METRICS_RATE_WINDOW=1s

# ── 完整配置参考 ──
# 所有可用环境变量见 docs/env-vars.md 和 backend/.env.production.example
