# ===== Xirang 部署配置 =====
# 复制此文件为 .env 并修改以下必改项
# 官方稳定版镜像固定为 docker.io/linnea7171/xirang。
# 快速试用可直接使用 latest；生产环境建议显式固定 IMAGE_TAG=vX.Y.Z。
# IMAGE_TAG=vX.Y.Z
# 可选：开启版本检查，推荐指向 GitHub latest release API。
# VERSION_CHECK_URL=https://api.github.com/repos/xiangnan0811/xirang/releases/latest

APP_ENV=production

# 时区（IANA 名称）。All-in-One 镜像默认 Asia/Shanghai；显式写入便于审计。
TZ=Asia/Shanghai

# ── 数据库 ──
# 默认使用 SQLite（推荐小规模部署）
DB_TYPE=sqlite
SQLITE_PATH=/data/xirang.db
# PostgreSQL 模式（取消注释并填写连接信息）：
# DB_TYPE=postgres
# DB_DSN=host=db user=xirang password=<set-db-password> dbname=xirang port=5432 sslmode=disable

# ── 必改项（安全相关）──

# 初始管理员密码（仅首次启动且库中尚无 admin 时需要；已有 admin 后可留空）
ADMIN_INITIAL_PASSWORD=

# JWT 签名密钥（生产必填：≥32 字符强随机字符串）
JWT_SECRET=

# 敏感字段加密密钥（生产必填：≥16 字符；推荐 32 字节 base64）
DATA_ENCRYPTION_KEY=
# 仅轮替期间设置；用于历史 v1 字段解密和 domain-key v2 envelope rewrap，验证完成后清理。
# DATA_ENCRYPTION_LEGACY_KEY=

# ── 鉴权 ──
JWT_TTL=24h
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=1m
LOGIN_FAIL_LOCK_THRESHOLD=5
LOGIN_FAIL_LOCK_DURATION=15m
LOGIN_CAPTCHA_ENABLED=false
LOGIN_SECOND_CAPTCHA_ENABLED=false

# ── CORS ──
# 留空则自动允许同主机 Origin（适合通过 IP 或反向代理访问的场景）
# 多域名用逗号分隔，如 https://xirang.example.com
# 注意：生产环境禁止使用 *（通配符）
CORS_ALLOWED_ORIGINS=

# ── 日志 ──
# All-in-One 容器默认将应用日志写入 /logs/xirang.log，并由 docker-compose.yml 映射到 ./logs。
LOG_LEVEL=info

# ── SSH / 通知安全 ──
# 生产环境建议保持以下默认值：阻断私网 webhook，严格校验 known_hosts。
INTEGRATION_BLOCK_PRIVATE_ENDPOINTS=true
SSH_STRICT_HOST_KEY_CHECKING=true
SSH_AUTO_ACCEPT_NEW_HOSTS=true
SSH_KNOWN_HOSTS_PATH=/data/.ssh/known_hosts

# ── /metrics 端点（生产必填：非空、≥16 字符、不可用文档占位符）──
# 启动前请替换为 openssl rand -hex 32 生成的随机值；留空或占位符会拒绝启动。
METRICS_TOKEN=
METRICS_RATE_LIMIT=5
METRICS_RATE_WINDOW=1s

# ── 备份资产领域基础（安全默认关闭） ──
# CodeDefault 仍是 false。全新安装可以写 BACKUP_ASSETS_ENABLED=true，但仍须通过
# 库存盘点、导出根和密钥域就绪门禁；已有安装还须管理员确认。不要改已复制的 .env。
BACKUP_ASSETS_ENABLED=false
BACKUP_ASSETS_CATALOG_BATCH_SIZE=2000
BACKUP_ASSETS_CATALOG_BUILD_TIMEOUT=30m
BACKUP_ASSETS_REPOSITORY_RECONCILE_INTERVAL=15m
BACKUP_ASSETS_AUDIT_SEGMENT_MAX_EVENTS=10000
BACKUP_ASSETS_AUDIT_SEGMENT_MAX_AGE=24h
BACKUP_ASSETS_AUDIT_DETAIL_RETENTION_DAYS=180
BACKUP_ASSETS_AUDIT_CHECKPOINT_RETENTION_DAYS=2555
BACKUP_ASSETS_LEASE_DURATION=5m
BACKUP_ASSETS_LEASE_HEARTBEAT=60s
BACKUP_ASSETS_LEASE_ABSOLUTE_DEADLINE=168h
# 精确 Restic 恢复点发布与清单（保持默认值，除非已评估仓库规模与运行窗口）
BACKUP_ASSETS_PUBLICATION_RECONCILE_INTERVAL=5m
BACKUP_ASSETS_PUBLICATION_RECONCILE_BATCH_SIZE=100
BACKUP_ASSETS_PUBLICATION_WORKER_CONCURRENCY=2
BACKUP_ASSETS_PUBLICATION_MISSING_GRACE=30m
BACKUP_ASSETS_PUBLICATION_STREAM_MAX_BYTES=268435456
BACKUP_ASSETS_MANIFEST_TIMEOUT=2h
BACKUP_ASSETS_MANIFEST_MAX_BYTES=4294967296
BACKUP_ASSETS_MANIFEST_MAX_ENTRIES=10000000
BACKUP_ASSETS_MANIFEST_MAX_RECORD_BYTES=1048576
BACKUP_ASSETS_MANIFEST_MAX_DEPTH=4096

# ── Nginx CSP（可选）──
# 若前端构建使用外部 VITE_WS_URL，在此追加允许的 connect-src 源（空格分隔）：
# CSP_CONNECT_SRC_EXTRA=wss://ws.example.com

# ── 完整配置参考 ──
# 所有可用环境变量见 docs/env-vars.md 和 backend/.env.production.example
